{
  "expo": {
    "name": "Music Player 2.0",
    "slug": "music-player-20",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "musicplayer20",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raresbilcea.musicplayer20",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Music Player 2.0 uses your microphone to identify songs and transcribe lessons.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.raresbilcea.musicplayer20",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0e0c09",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0e0c09",
          "dark": {
            "backgroundColor": "#0e0c09"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Music Player 2.0 needs microphone access to identify songs and record lessons."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE-WITH-EAS-PROJECT-ID-AFTER-FIRST-BUILD"
      }
    }
  }
}
